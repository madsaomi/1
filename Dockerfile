FROM caddy:2-alpine

WORKDIR /srv

COPY Caddyfile /etc/caddy/Caddyfile
COPY index.html results.html career.html teachers.html privacy.html content.js results.js career.js script.js theme-init.js style.css robots.txt sitemap.xml ./
COPY assets/ ./assets/
# Uzbek and Karakalpak copies of the public pages, generated by build.mjs.
COPY uz/ ./uz/
COPY kaa/ ./kaa/

RUN caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile

EXPOSE 8080

CMD ["caddy", "run", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile"]
