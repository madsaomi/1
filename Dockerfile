# An exact Caddy release: a rebuild never changes the server by surprise. Update the number on purpose.
FROM caddy:2.11.9-alpine

WORKDIR /srv

COPY Caddyfile /etc/caddy/Caddyfile
COPY index.html results.html career.html teachers.html privacy.html feedback.html content.js results.js career.js feedback.js script.js theme-init.js style.css robots.txt sitemap.xml ./
COPY assets/ ./assets/
# Uzbek and Karakalpak copies of the public pages, generated by build.mjs.
COPY uz/ ./uz/
COPY kaa/ ./kaa/
COPY en/ ./en/
# One page per course (/courses/ielts …), generated by build.mjs from templates/course.html.
COPY courses/ ./courses/

RUN caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile

EXPOSE 8080

CMD ["caddy", "run", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile"]
