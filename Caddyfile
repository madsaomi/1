{
	admin off
	persist_config off
	auto_https off
}

# Shared by normal responses and error pages (handle_errors builds its own response).
(security_headers) {
	header X-Content-Type-Options nosniff
	header Referrer-Policy strict-origin-when-cross-origin
	header X-Frame-Options DENY
	# Cloudflare Web Analytics: its beacon script and the endpoint it reports to (no cookies).
	# Cloudflare Turnstile («not a robot» in the forms): its script and frame from challenges.cloudflare.com.
	header Content-Security-Policy "default-src 'self'; script-src 'self' https://static.cloudflareinsights.com https://challenges.cloudflare.com; style-src 'self'; img-src 'self' data: blob:; media-src 'self'; font-src 'self'; connect-src 'self' https://cloudflareinsights.com; frame-src https://yandex.ru https://www.google.com https://challenges.cloudflare.com; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
	header Permissions-Policy "camera=(), microphone=(), geolocation=()"
	# Pages opened from the site (Telegram, maps) cannot reach back into it, and it cannot reach into them.
	header Cross-Origin-Opener-Policy "same-origin"
	# Railway serves the site over HTTPS only; browsers remember that for a year (no preload, no subdomains).
	header Strict-Transport-Security "max-age=31536000"
}

:{$PORT:8080} {
	root * /srv
	encode zstd gzip

	import security_headers

	# Keep one public address while leaving Railway health checks reachable on every host.
	@old_public_host {
		host 1-production-8f16.up.railway.app www.stanford-lc.uz
		not path /healthz
	}
	redir @old_public_host https://stanford-lc.uz{uri} 308

	# Files linked with ?v=… change their address on every edit, so browsers may keep them for a year.
	@versioned query v=*
	header @versioned Cache-Control "public, max-age=31536000, immutable"

	@static {
		path /assets/*
		not query v=*
	}
	header @static Cache-Control "public, max-age=86400, must-revalidate"

	@mutable {
		path / /index.html /results.html /teachers.html /career.html /privacy.html /feedback.html /results /teachers /career /privacy /feedback /content.js /script.js /results.js /career.js /feedback.js /theme-init.js /style.css /robots.txt /sitemap.xml /uz /uz/* /kaa /kaa/* /en /en/* /courses/*
		not query v=*
	}
	header @mutable Cache-Control no-cache

	# Public page addresses have no «.html»: old links are sent to the short address once.
	@html_index path_regexp html_index ^(/(?:uz/|kaa/|en/)?)index\.html$
	redir @html_index {re.html_index.1}{?query} 301
	@html_page path_regexp html_page ^(/(?:uz/|kaa/|en/)?)(results|teachers|career|privacy|feedback|courses/[a-z0-9-]+)\.html$
	redir @html_page {re.html_page.1}{re.html_page.2}{?query} 301

	# HR remains a separate service: only form submissions (POST /career, POST /feedback) go there; GET shows the pages.
	@hr_submit {
		path /career /feedback
		method POST
	}
	handle @hr_submit {
		request_body {
			max_size 4MB
		}
		reverse_proxy {$HR_API_UPSTREAM:127.0.0.1:8787} {
			transport http {
				response_header_timeout 40s
			}
		}
	}
	handle {
		respond /healthz "ok" 200
		# /career → career.html (the same in /uz/ and /kaa/).
		try_files {path} {path}.html
		file_server
	}

	# Branded 404 page; file_server keeps the 404 status inside handle_errors.
	handle_errors {
		import security_headers
		header Cache-Control no-cache

		@missing expression `{err.status_code} == 404`
		handle @missing {
			rewrite * /assets/errors/404.html
			file_server
		}
		respond "{err.status_code} {err.status_text}"
	}
}
